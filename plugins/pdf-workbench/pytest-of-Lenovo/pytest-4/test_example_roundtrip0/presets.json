{
  "version": 1,
  "presets": {
    "table-archive": {
      "description": "表格归档：Parquet + zstd，重名自动改名，保留时间戳",
      "options": {},
      "convert": {
        "compression": "zstd"
      },
      "output": {
        "on_conflict": "rename",
        "preserve_timestamps": true
      }
    },
    "table-share": {
      "description": "表格分发：XLSX/CSV 常用设置，重名跳过",
      "options": {},
      "convert": {},
      "output": {
        "on_conflict": "skip"
      }
    },
    "document-web": {
      "description": "文档发布：HTML 输出，重名自动改名",
      "options": {},
      "convert": {},
      "output": {
        "on_conflict": "rename",
        "preserve_timestamps": true
      }
    },
    "image-web": {
      "description": "图片发布：质量 82、优化编码、去元数据、重名自动改名",
      "options": {
        "quality": 82,
        "optimize": true,
        "strip_metadata": true
      },
      "convert": {},
      "output": {
        "on_conflict": "rename"
      }
    }
  }
}
